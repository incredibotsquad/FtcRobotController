<!--
  FTC Robot Configuration: Control Hub + Limelight 3A
  Put on the Control Hub at: /sdcard/FIRST/limelight_robot.xml
  Then activate it in Driver Station > Configure Robot.

  Java:  Limelight3A limelight = hardwareMap.get(Limelight3A.class, "limelight");
-->
<Robot type="FirstInspires-FTC">

    <!-- Control Hub (built-in Lynx module, address 173) -->
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Control Hub" port="173">
            <!-- Built-in IMU: uncomment the one that matches your hub -->
            <!-- Newer Control Hubs (BHI260AP): -->
            <!-- <ControlHubImuBHI260AP name="imu" port="0" bus="0" /> -->
            <!-- Older Control Hubs (BNO055): -->
            <!-- <LynxEmbeddedIMU name="imu" port="0" bus="0" /> -->

            <!-- Add motors / servos / sensors here -->
        </LynxModule>
    </LynxUsbDevice>

    <!-- Limelight 3A on the Control Hub's blue USB 3.0 port.
         172.29.0.1 is the factory address (USB ID 0). If you set a
         static IP on the Limelight, change BOTH values below to match. -->
    <EthernetDevice name="limelight" serialNumber="EthernetOverUsb:eth0:172.29.0.1" ipAddress="172.29.0.1" />

</Robot>